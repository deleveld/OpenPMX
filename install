# WITHOUT ANY WARRANTY; without even the implied warranty of
# MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE. See the GNU
# General Public License for more details.
#
# You should have received a copy of the GNU General Public License
# along with this program. If not, see <http://www.gnu.org/licenses/>.

set -euo pipefail

# handle command line arguments
TARGET="pthread"
SERVER="notserver"
while (( $# )); do
    case $1 in
        pthread)
			TARGET="pthread"
            ;;
        openmp)
			TARGET="openmp"
            ;;
        singlethread)
			TARGET="singlethread"
            ;;
        server)
            SERVER="server"
            ;;
        notserver)
            SERVER="notserver"
            ;;
        clean)
			TARGET="clean"
            ;;
        --help)
			printf "This file installs OpenPMX (https://github.com/deleveld/openpmx).\n"
			exit 1
			;;
        *)
			printf "error: argument %s not recognized\n" "${1}" >&2
			exit 1
            ;;
    esac
    shift
done

# print success/failed message when done
EXITMESSAGE="failed"
cleanup() {
	printf "openpmx install $EXITMESSAGE\n"
}
trap cleanup EXIT

# find out about the platform and the path
detect_platform() {
    case "$OSTYPE" in
        darwin*)  echo "macos" ;;
        msys*)    echo "msys2" ;;
        cygwin*)  echo "msys2" ;;
        linux*)   echo "linux" ;;
        *)
            if grep -qi microsoft /proc/version 2>/dev/null; then
                echo "wsl"
            else
                echo "unknown"
            fi
            ;;
    esac
}
PLATFORM=$(detect_platform)
OPENPMXPATH=$(cd "$(dirname "${0}")" && pwd)
printf "install %s %s %s\n" "${TARGET}" "${SERVER}" "${PLATFORM}"
printf "path %s\n" "${OPENPMXPATH}"

# Windows executables need .exe
EXEEXT=""
if [ "${PLATFORM}" = "msys2" ]; then
	EXEEXT=".exe"
fi

# cleanup previous build
mkdir -p "${OPENPMXPATH}/build" "${OPENPMXPATH}/bin" "${OPENPMXPATH}/lib"
rm -vf "${OPENPMXPATH}"/build/*.o
rm -vf "${OPENPMXPATH}/bin/openpmxtran" "${OPENPMXPATH}/bin/openpmxtran.exe"
rm -vf "${OPENPMXPATH}"/lib/*.a
rm -vf "${OPENPMXPATH}/openpmx" "${OPENPMXPATH}/openpmx.exe"
rm -vf "${OPENPMXPATH}/src/buildflags.h"
if [ "${TARGET}" = "clean" ]; then
	EXITMESSAGE="clean success"
    exit 0
fi

# general build flags
CC="${CC:-gcc}"
LIBNAME="openpmx"
CFLAGS="-g -O2 -W -Wall -Wextra -march=native -mtune=native"
CLIBFLAGS="-Wfloat-conversion -Wformat -Werror=format-security -Wno-override-init -Wwrite-strings -Isrc"
LFLAGS=""
LDLIBS="-lgsl -lgslcblas -lm"
AR="ar rcs lib/lib${LIBNAME}.a"

# adjust flags for different platforms
case "${PLATFORM}" in
    macos*)
        CLIBFLAGS="${CLIBFLAGS} -fPIC"
        ARCH=$(uname -m)
        if [ "$ARCH" = "arm64" ]; then
            CFLAGS="${CFLAGS} -mcpu=apple-m1"
        else
            CFLAGS="${CFLAGS} -march=native"
        fi
        LFLAGS="${LFLAGS} -flto"
        ;;
    linux*|wsl*)
        CFLAGS="${CFLAGS}"
        CLIBFLAGS="${CLIBFLAGS} -fPIC"
        LFLAGS="${LFLAGS} -flto"
        ;;
    msys2*)
        CFLAGS="${CFLAGS} -I/mingw64/include"
        LFLAGS="${LFLAGS} -L\"${OPENPMXPATH}/lib\" -L/mingw64/lib"
        LFLAGS="${LFLAGS} -flto"
        ;;
    *)
        printf "error: platform %s not recognized\n" "${PLATFORM}" >&2
        exit 1
        ;;
esac

# initialize build flags
{
    printf "#define OPENPMX_INSTALL_PLATFORM_%s\n" "${PLATFORM}"
    printf "#define OPENPMX_INSTALL_PLATFORM_NAME \"%s\"\n" "${PLATFORM}"
    printf "#define OPENPMX_INSTALL_PATH \"%s\"\n" "${OPENPMXPATH}"
} >> "${OPENPMXPATH}/src/buildflags.h"

# handle different flags for targets
case "${TARGET}" in
    openmp)
        CFLAGS="${CFLAGS} -fopenmp"
        LFLAGS="${LFLAGS} -fopenmp"
        LDLIBS="${LDLIBS} -lgomp"
        printf "#define OPENPMX_PARALLEL_OPENMP\n" >> "${OPENPMXPATH}/src/buildflags.h"
        ;;
    pthread)
        CFLAGS="${CFLAGS} -pthread"
        LFLAGS="${LFLAGS} -pthread"
        printf "#define OPENPMX_PARALLEL_PTHREADS\n" >> "${OPENPMXPATH}/src/buildflags.h"
        ;;
    singlethread)
        printf "#define OPENPMX_PARALLEL_SINGLETHREAD\n" >> "${OPENPMXPATH}/src/buildflags.h"
        ;;
    *)
        printf "error: target \"%s\" not recognized\n" "${TARGET}" >&2
        exit 1
        ;;
esac

# for server the queue is in the install dir so only a single instance
# can run per install.
case "${SERVER}" in
    server)
        printf "#define OPENPMX_SERVER\n" >> "${OPENPMXPATH}/src/buildflags.h"
		;;
    notserver)
        printf "#define OPENPMX_NOTSERVER\n" >> "${OPENPMXPATH}/src/buildflags.h"
        ;;
    *)
        printf "error: server \"%s\" not recognized\n" "${SERVER}" >&2
        exit 1
        ;;
esac

# compile openpmxtran
printf "compile openpmxtran\n"
(cd "${OPENPMXPATH}" && ${CC} ${CFLAGS} "src/openpmxtran.c" -o "bin/openpmxtran${EXEEXT}" ${LFLAGS} -lm)

# compile source code to object files
SOURCEFILES="pmxstate.c options.c ievaluate.c predict.c stage1.c
			 checkout.c popmodel.c encode.c nonzero.c omegainfo.c
			 linalg.c print.c idata.c table.c scatter.c estimate.c
			 simulate.c reload.c server_queue.c
			 profile.c covariance.c vpc.c npde.c
			 dataconfig/dataconfig.c
			 advan/advan.c advan/pred.c
			 advan/onecomp.c advan/onecomp_depot.c
			 advan/twocomp.c advan/threecomp.c
			 advan/diffeqn_test.c advan/diffeqn_libgsl.c
			 advan/eigen.c advan/tci.c
			 models/propofol_eleveld.c
			 models/propofol_schnider.c
			 models/remifentanil_eleveld.c
			 models/remifentanil_minto.c
			 models/sufentanil_gepts.c
			 models/remimazolam_eleveld.c
			 utils/vector.c utils/various.c
			 utils/getdelim.c utils/errctx.c utils/filecontent.c
			 bobyqa/bobyqa.c"
OBJECTFILES=""
for FILE in ${SOURCEFILES}; do
    printf "compile %s\n" "${FILE}"
    BASE=$(basename "${FILE}")
    OBJFILE="${BASE%.*}.o"
    (cd "${OPENPMXPATH}" && ${CC} ${CFLAGS} ${CLIBFLAGS} -Iinclude -c "src/${FILE}" -o "build/${OBJFILE}")
    OBJECTFILES="${OBJECTFILES} build/${OBJFILE}"
done

# build library from object files
printf "build library\n"
(cd "${OPENPMXPATH}" && ${AR} ${OBJECTFILES})

# compile the C launcher (replaces the old bash script)
printf "compile openpmx launcher\n"

# escape backslashes and double quotes so a value can be embedded in a C
# string literal (the msys2 LFLAGS contain double quotes)
cstr() {
	local s="${1//\\/\\\\}"
	printf '"%s"' "${s//\"/\\\"}"
}

# compile launcher
LAUNCHER_CFLAGS="-g -O2 -Wall"
(cd "${OPENPMXPATH}" && ${CC} ${LAUNCHER_CFLAGS} \
	-DOPENPMX_CC="$(cstr "${CC}")" \
	-DOPENPMX_CFLAGS="$(cstr "${CFLAGS}")" \
	-DOPENPMX_LFLAGS="$(cstr "${LFLAGS}")" \
	-DOPENPMX_LDLIBS="$(cstr "${LDLIBS}")" \
	-DOPENPMX_PATH="$(cstr "${OPENPMXPATH}")" \
	"src/openpmx_launcher.c" \
	-o "openpmx${EXEEXT}")

# exit with success message
EXITMESSAGE="success"
