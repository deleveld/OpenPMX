//
//	Schnider T, Minto C, Gambus P, Andresen C, Goodale D, Shafer S, Youngs E:
//	The influence of method of administration and covariates on the pharmacokinetics
//	of propofol in adult volunteers. Anesthesiology 1998; 88:1170–82 PMID: 9605675
//
//	Data obtained from http://opentci.org/data/propofol/schnider-1998-study (Nov 6 2020)
//	 - changed CP name to DV
//
$DATA(data.csv)
$ADVAN(threecomp) 
	.firstonly = true,
$IMODEL(V1, V2, V3, CL, Q2, Q3)
	const double SIZE = WT/70.;
	V1 = THETA(1) * SIZE * exp(ETA(1));
	V2 = THETA(2) * SIZE * exp(ETA(2) + THETA(7)*(AGE-35)); /* a comment */
	V3 = THETA(3) * SIZE * exp(ETA(3));
	CL = THETA(4) * pow(SIZE, 0.75) * exp(ETA(4));
	Q2 = THETA(5) * pow(V2/THETA(2), 0.75) * exp(ETA(5));
	Q3 = THETA(6) * pow(V3/THETA(3), 0.75) * exp(ETA(6));
$PREDICT(IPRED)
	IPRED = A(1)/V1;
	Y = IPRED*(1 + ERR(1));
$THETA
	{   1,   4,   10,  ESTIMATE     },
	{   5,   20,   50,  ESTIMATE     },
	{   20,   100,   1000,  ESTIMATE     },
	{   0.1,   2,   5,  ESTIMATE     },
	{   0.1,   2,   5,  ESTIMATE     },
	{   0.1,   1,   5,  ESTIMATE     },
	{   -.1,   0,   .1,  ESTIMATE     },
$OMEGA(0.1, 0.1, 0.1, 0.1, 0., 0.)
$SIGMA(0.1)
$MAIN
//	ESTIMCONFIG estim = { .stage1.laplace=true };
	ESTIMCONFIG estim = { };

	pmx_estimate(&openpmx, &estim);
	
	COVARIANCECONFIG covconfig = { 
		.type=COVARIANCE_S_MATRIX, 
		.stage1 = estim.stage1 
	};
	pmx_covariance(&openpmx, &covconfig);

	profile_clean();
	int nextra = 0;
	profile(.param = { 
				.type=PARAM_THETA, 
				.index = 1,
				.lower = 1.,
				.upper = 40. },
			.estimate = estim,
			.nextra = nextra, 
			);
	profile(.param = { 
				.type=PARAM_THETA, 
				.index = 2,
				.lower = 5.,
				.upper = 100. },
			.estimate = estim,
			.nextra = nextra,
			);
	profile(.param = { 
				.type=PARAM_THETA, 
				.index = 3,
				.lower = 100.,
				.upper = 400. },
			.estimate = estim,
			.nextra = nextra, 
			); 
	profile(.param = { 
				.type=PARAM_THETA, 
				.index = 4,
				.lower = 1.,
				.upper = 3. },
			.estimate = estim,
			.nextra = nextra,
			); 
	profile(.param = { 
				.type=PARAM_THETA, 
				.index = 5,
				.lower = 1.,
				.upper = 3. },
			.estimate = estim,
			.nextra = nextra,
			); 
	profile(.param = { 
				.type=PARAM_THETA, 
				.index = 6,
				.lower = 0.1,
				.upper = 3. },
			.estimate = estim,
			.nextra = nextra,
			); 
	profile(.param = { 
				.type=PARAM_THETA, 
				.index = 7,
				.lower = -0.1,
				.upper = 0.1 },
			.estimate = estim,
			.nextra = nextra,
			); 
			
	profile(.param = { 
				.type=PARAM_OMEGA, 
				.index = 1,
				.lower = 1e-3,
				.upper = 1. },
			.estimate = estim,
			.nextra = nextra,
			);
	profile(.param = { 
				.type=PARAM_OMEGA, 
				.index = 2,
				.lower = 1e-6,
				.upper = 1. },
			.estimate = estim,
			.nextra = nextra,
			);
	profile(.param = { 
				.type=PARAM_OMEGA, 
				.index = 3,
				.lower = 1e-6,
				.upper = 1. },
			.estimate = estim,
			.nextra = nextra,
			);
	profile(.param = { 
				.type=PARAM_OMEGA, 
				.index = 4,
				.lower = 1e-6,
				.upper = 1. },
			.estimate = estim,
			.nextra = nextra,
			);
	profile(.param = { 
				.type=PARAM_SIGMA, 
				.index = 1,
				.lower = 0.0547787 - 0.01,
				.upper = 0.0547787 + 0.01 },
			.estimate = estim,
			.nextra = nextra,
			);
	
/*	do_profile(PARAM_THETA, 2, 5, 100);
	do_profile(PARAM_THETA, 3, 100, 400);
	do_profile(PARAM_THETA, 4, .5, 4);
	do_profile(PARAM_THETA, 5, .1, 4);
	do_profile(PARAM_THETA, 6, .1, 4);
	do_profile(PARAM_THETA, 7, -.1, .1);
	do_profile(PARAM_OMEGA, 1, 1e-6, 1);
	do_profile(PARAM_OMEGA, 2, 1e-6, 1);
	do_profile(PARAM_OMEGA, 3, 1e-6, 1);
	do_profile(PARAM_OMEGA, 4, 1e-6, 1);
	do_profile(PARAM_SIGMA, 1, 0.045, 0.65);
*/
	
